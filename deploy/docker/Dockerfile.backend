# syntax=docker/dockerfile:1
#
# Backend image: runs `uvicorn backend.main:app`. Build from the repo root:
#   docker build -f deploy/docker/Dockerfile.backend -t insightpilot-backend .
#
# All configuration is supplied through environment variables (see
# config/settings.py / deploy/README.md) — nothing about which profile,
# host, or port this container runs with is hardcoded here.

FROM python:3.12-slim AS base

# uv: the same dependency manager this project already uses locally
# (pyproject.toml + uv.lock) — installed by copying its static binary
# rather than a package-manager step, per astral's own documented
# Docker pattern.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Dependencies first, in their own layer, so an application code change
# doesn't invalidate the (much slower) dependency-install layer.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

COPY backend/ ./backend/
COPY shared/ ./shared/
COPY config/ ./config/

RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# Shell form (not exec form) so $HOST/$PORT — the same environment
# variables config/settings.py itself reads — are honored at container
# start, not baked in at build time. Defaults match Settings' own.
CMD uvicorn backend.main:app --host ${HOST:-0.0.0.0} --port ${PORT:-8000}
