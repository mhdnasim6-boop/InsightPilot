# ---- Model provider switch: "ollama" (local) or "openai" (cloud) ----
LLM_PROVIDER=ollama

# Local: run `ollama pull qwen2.5:3b` first
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# Cloud
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Research Agent (web search) ----
TAVILY_API_KEY=

# ---- Email sending (optional). If SMTP_HOST is empty, approved emails are
# ---- saved to data/outbox/ as .eml files instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Optional: LangSmith tracing (shows which agents ran for each question) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=insightpilot

# ---- Optional overrides ----
# INSIGHTPILOT_DATA_DIR=./data
