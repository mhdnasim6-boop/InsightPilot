# Copy this file to .env and adjust values as needed.
# All values below have sensible defaults in config/settings.py;
# only set what you need to override.

APP_NAME=InsightPilot
APP_VERSION=0.1.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000
DEBUG=true

FRONTEND_URL=http://localhost:8501
BACKEND_URL=http://localhost:8000

LOG_LEVEL=INFO

# AI configuration (provider-agnostic AI infrastructure — see backend/ai/)
# AI_DEFAULT_PROVIDER: mock | auto | ollama | openai
#   mock  - deterministic, network-free (the default — what the test suite relies on)
#   auto  - detect what's available at startup: Ollama reachable? -> Ollama.
#           Else OPENAI_API_KEY set? -> OpenAI. Else -> Mock. Recommended for a real deployment.
#   ollama / openai - force that provider explicitly.
AI_DEFAULT_PROVIDER=ollama
AI_DEFAULT_MODEL=qwen2.5:3b
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=30.0
AI_STREAMING_ENABLED=true
AI_RETRY_COUNT=2

# Ollama (local LLM server) — only used when AI_DEFAULT_PROVIDER is ollama/auto.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI (or an OpenAI-compatible endpoint) — only used when AI_DEFAULT_PROVIDER is openai/auto.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
